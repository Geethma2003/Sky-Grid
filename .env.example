# SkyGrid Enterprise - Environment Configuration
# ================================================
# Copy this file to .env and fill in your values.
# All API keys are OPTIONAL - the system will fall back
# to the built-in Deterministic Simulation & Reasoning Engine.

# --- LLM Provider (choose one) ---
# Google Gemini API
GEMINI_API_KEY=

# Groq API
GROQ_API_KEY=

# --- Default Map Center (Colombo, Sri Lanka) ---
DEFAULT_LAT=6.9271
DEFAULT_LON=79.8612

# --- Server Configuration ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
